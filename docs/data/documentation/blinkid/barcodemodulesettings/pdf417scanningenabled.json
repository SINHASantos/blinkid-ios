{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Enables the scanning and processing of Pdf417 barcodes.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/BarcodeModuleSettings"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/blinkid\/barcodemodulesettings\/pdf417scanningenabled"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/BarcodeModuleSettings\/pdf417ScanningEnabled"},"sections":[],"metadata":{"externalID":"s:7BlinkID21BarcodeModuleSettingsV21pdf417ScanningEnabledSbvp","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pdf417ScanningEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"symbolKind":"property","role":"symbol","title":"pdf417ScanningEnabled","modules":[{"name":"BlinkID"}]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pdf417ScanningEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The current analyzer model flags a barcode as “present” if either a ","type":"text"},{"type":"codeVoice","code":"PDF417"},{"text":" or a ","type":"text"},{"type":"codeVoice","code":"QR"},{"text":" code is detected.","type":"text"},{"text":" ","type":"text"},{"text":"Because the model does not distinguish between the two types at this stage, a conflict can occur:","type":"text"},{"text":" ","type":"text"},{"text":"if ","type":"text"},{"type":"codeVoice","code":"PDF417"},{"text":" is enabled but ","type":"text"},{"type":"codeVoice","code":"QR"},{"text":" is disabled, the analyzer may trigger for a ","type":"text"},{"type":"codeVoice","code":"QR"},{"text":" code, causing the process to hang.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To prevent this, "},{"type":"codeVoice","code":"pdf417ScanningEnabled"},{"type":"text","text":" and "},{"type":"codeVoice","code":"qrScanningEnabled"},{"type":"text","text":" must be enabled together."}]}],"kind":"content"}],"references":{"doc://com.microblink.BlinkID/documentation/BlinkID/BarcodeModuleSettings/pdf417ScanningEnabled":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pdf417ScanningEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Enables the scanning and processing of Pdf417 barcodes.","type":"text"}],"url":"\/documentation\/blinkid\/barcodemodulesettings\/pdf417scanningenabled","identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/BarcodeModuleSettings\/pdf417ScanningEnabled","role":"symbol","type":"topic","title":"pdf417ScanningEnabled","kind":"symbol"},"doc://com.microblink.BlinkID/documentation/BlinkID":{"identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","title":"BlinkID","url":"\/documentation\/blinkid","type":"topic","abstract":[],"role":"collection","kind":"symbol"},"doc://com.microblink.BlinkID/documentation/BlinkID/BarcodeModuleSettings":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BarcodeModuleSettings","kind":"identifier"}],"abstract":[{"type":"text","text":"Settings for the barcode extraction module."}],"navigatorTitle":[{"text":"BarcodeModuleSettings","kind":"identifier"}],"url":"\/documentation\/blinkid\/barcodemodulesettings","identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/BarcodeModuleS