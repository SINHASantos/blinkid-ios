{"hierarchy":{"paths":[["doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings"]]},"abstract":[{"text":"Represents the strategy used to select the best input image from a pool of stable input images.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings\/inputImageSelectionStrategy"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"inputImageSelectionStrategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/InputImageSelectionStrategy","preciseIdentifier":"s:7BlinkID27InputImageSelectionStrategyO","text":"InputImageSelectionStrategy"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Before selecting the best quality image, a sequence of stable input images must be available. From this pool of input images,","type":"text"},{"text":" ","type":"text"},{"text":"the one with the highest quality is selected. An input image is considered stable if the image analysis results are consistent","type":"text"},{"text":" ","type":"text"},{"text":"across consecutive stream of input images.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A larger pool size increases the likelihood of capturing a high-quality image but may introduce a slight delay,","type":"text"},{"text":" ","type":"text"},{"text":"as more stable input images need to be collected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Available strategies are: ","type":"text"},{"code":"SingleImage","type":"codeVoice"},{"text":", ","type":"text"},{"code":"OptimizeForSpeed","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Balanced","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"OptimizeForQuality","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Default strategy represents a trade-off between speed and quality, while ","type":"text"},{"code":"OptimizeForSpeed","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"OptimizeForQuality","type":"codeVoice"},{"text":" represent","type":"text"},{"text":" ","type":"text"},{"text":"strategies optimized for speed and quality, respectively.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This setting is applicable only for "},{"type":"codeVoice","code":"Video"},{"type":"text","text":" input image source."}]}]}],"metadata":{"symbolKind":"property","role":"symbol","modules":[{"name":"BlinkID"}],"externalID":"s:7BlinkID29DocumentCaptureModuleSettingsV27inputImageSelectionStrategyAA05InputhiJ0Ovp","title":"inputImageSelectionStrategy","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inputImageSelectionStrategy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"InputImageSelectionStrategy","kind":"typeIdentifier","preciseIdentifier":"s:7BlinkID27InputImageSelectionStrategyO"}]},"variants":[{"paths":["\/documentation\/blinkid\/documentcapturemodulesettings\/inputimageselectionstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.microblink.BlinkID/documentation/BlinkID/DocumentCaptureModuleSettings":{"navigatorTitle":[{"text":"DocumentCaptureModuleSettings","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings","title":"DocumentCaptureModuleSettings","abstract":[{"text":"Settings for the document capture module.","type":"text"}],"url":"\/documentation\/blinkid\/documentcapturemodulesettings","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"DocumentCaptureModuleSettings","kind":"identifier"}]},"doc://com.microblink.BlinkID/documentation/BlinkID":{"identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","title":"BlinkID","url":"\/documentation\/blinkid","type":"topic","abstract":[],"role":"collection","kind":"symbol"},"doc://com.microblink.BlinkID/documentation/BlinkID/DocumentCaptureModuleSettings/inputImageSelectionStrategy":{"kind":"symbol","url":"\/documentation\/blinkid\/documentcapturemodulesettings\/inputimageselectionstrategy","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Represents the strategy used to select the best input image from a pool of stable input images."}],"title":"inputImageSelectionStrategy","identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings\/inputImageSelectionStrategy","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inputImageSelectionStrategy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"InputImageSelectionStrategy","preciseIdentifier":"s:7BlinkID27InputImageSelectionStrategyO","kind":"typeIdentifier"}]},"doc://com.microblink.BlinkID/documentation/BlinkID/InputImageSelectionStrategy":{"kind":"symbol","url":"\/documentation\/blinkid\/inputimageselectionstrategy","type":"topic","role":"symbol","abstract":[{"text":"Represents the strategy used to select the best input image from a pool of stable input images.","type":"text"}],"title":"InputImageSelectionStrategy","identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/InputImageSelectionStrategy","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"InputImageSelectionStrategy"}],"navigatorTitle":[{"kind":"identifier","text":"InputImageSelectionStrategy"}]}}}