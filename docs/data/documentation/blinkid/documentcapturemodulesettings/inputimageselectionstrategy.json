{"abstract":[{"text":"Represents the strategy used to select the best input image from a pool of stable input images.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"inputImageSelectionStrategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"InputImageSelectionStrategy","identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/InputImageSelectionStrategy","preciseIdentifier":"s:7BlinkID27InputImageSelectionStrategyO"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Before selecting the best quality image, a sequence of stable input images must be available. From this pool of input images,"},{"type":"text","text":" "},{"type":"text","text":"the one with the highest quality is selected. An input image is considered stable if the image analysis results are consistent"},{"type":"text","text":" "},{"type":"text","text":"across consecutive stream of input images."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A larger pool size increases the likelihood of capturing a high-quality image but may introduce a slight delay,"},{"type":"text","text":" "},{"type":"text","text":"as more stable input images need to be collected."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Available strategies are: "},{"type":"codeVoice","code":"SingleImage"},{"type":"text","text":", "},{"type":"codeVoice","code":"OptimizeForSpeed"},{"type":"text","text":", "},{"type":"codeVoice","code":"Balanced"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OptimizeForQuality"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Default strategy represents a trade-off between speed and quality, while "},{"type":"codeVoice","code":"OptimizeForSpeed"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OptimizeForQuality"},{"type":"text","text":" represent"},{"type":"text","text":" "},{"type":"text","text":"strategies optimized for speed and quality, respectively."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This setting is applicable only for "},{"type":"codeVoice","code":"Video"},{"type":"text","text":" input image source."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings\/inputImageSelectionStrategy"},"metadata":{"externalID":"s:7BlinkID29DocumentCaptureModuleSettingsV27inputImageSelectionStrategyAA05InputhiJ0Ovp","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"inputImageSelectionStrategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"InputImageSelectionStrategy","preciseIdentifier":"s:7BlinkID27InputImageSelectionStrategyO"}],"role":"symbol","title":"inputImageSelectionStrategy","modules":[{"name":"BlinkID"}],"symbolKind":"property"},"hierarchy":{"paths":[["doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings"]]},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/blinkid\/documentcapturemodulesettings\/inputimageselectionstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://com.microblink.BlinkID/documentation/BlinkID":{"role":"collection","url":"\/documentation\/blinkid","type":"topic","abstract":[],"identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","title":"BlinkID","kind":"symbol"},"doc://com.microblink.BlinkID/documentation/BlinkID/DocumentCaptureModuleSettings":{"abstract":[{"text":"Settings for the document capture module.","type":"text"}],"fragme