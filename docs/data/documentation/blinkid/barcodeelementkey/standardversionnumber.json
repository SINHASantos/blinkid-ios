{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"standardVersionNumber","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"AAMVA Version Number: This is a decimal value between 0 and 99 that","type":"text"},{"text":" ","type":"text"},{"text":"specifies the version level of the PDF417 bar code format. Version “0” and “00”","type":"text"},{"text":" ","type":"text"},{"text":"is reserved for bar codes printed to the specification of the American Association","type":"text"},{"text":" ","type":"text"},{"text":"of Motor Vehicle Administrators (AAMVA) prior to the adoption of the AAMVA DL\/ID-2000","type":"text"},{"text":" ","type":"text"},{"text":"standard.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"All barcodes compliant with AAMVA DL\/ID-2000 standard shall be designated Version “01.”","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All barcodes compliant with AAMVA Card Design Specification version 1.0, dated 09-2003","type":"text"},{"text":" ","type":"text"},{"text":"shall be designated Version “02.”","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All barcodes compliant with AAMVA Card Design Specification version 2.0, dated 03-2005","type":"text"},{"text":" ","type":"text"},{"text":"shall be designated Version “03.”","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All barcodes compliant with AAMVA Card Design Standard version 1.0, dated 07-2009","type":"text"},{"text":" ","type":"text"},{"text":"shall be designated Version “04.”","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All barcodes compliant with AAMVA Card Design Standard version 1.0, dated 07-2010","type":"text"},{"text":" ","type":"text"},{"text":"shall be designated Version “05.”","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All barcodes compliant with AAMVA Card Design Standard version 1.0, dated 07-2011","type":"text"},{"text":" ","type":"text"},{"text":"shall be designated Version “06”.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All barcodes compliant with AAMVA Card Design Standard version 1.0, dated 06-2012","type":"text"},{"text":" ","type":"text"},{"text":"shall be designated Version “07”.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All barcodes compliant with this current AAMVA standard shall be designated “08”.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"If the document type is not “AAMVA”, this field defines the version number of the","type":"text"},{"text":" ","type":"text"},{"text":"given document type’s standard.","type":"text"}],"type":"paragraph"}]}],"metadata":{"role":"symbol","symbolKind":"case","modules":[{"name":"BlinkID"}],"roleHeading":"Case","title":"BarcodeElementKey.standardVersionNumber","externalID":"s:7BlinkID17BarcodeElementKeyO21standardVersionNumberyA2CmF","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"standardVersionNumber","kind":"identifier"}]},"sections":[],"variants":[{"paths":["\/documentation\/blinkid\/barcodeelementkey\/standardversionnumber"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Mandatory on all driver’s licenses.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/BarcodeElementKey\/standardVersionNumber"},"hierarchy":{"paths":[["doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/BarcodeElementKey"]]},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"references"